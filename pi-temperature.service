# systemd unit for pi-temperature.
#
# Install:
#   sudo cp pi-temperature.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pi-temperature
#
# Adjust User and the paths if you cloned somewhere other than ~/pi-temperature.

[Unit]
Description=DHT22 temperature/humidity Prometheus exporter
Wants=network-online.target
After=network-online.target

[Service]
User=bud
WorkingDirectory=/home/bud/pi-temperature
# The venv is built ahead of time with `uv sync --frozen --no-dev`,
# so startup needs no network access.
ExecStart=/home/bud/pi-temperature/.venv/bin/python temperature.py
Environment=PORT=5000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
